#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# Hardening
# gcc is built with --enable-default-pie on most architectures, so
# dpkg-buildflags treats PIE as a compiler builtin and does not emit
# -fPIE/-pie. blhc only inspects the command lines and reports them as
# missing, so append them explicitly to keep the build log clean.
# Appending unconditionally is safe: a duplicate -fPIE is harmless where
# the compiler is not default-PIE and dpkg-buildflags already adds it.
export DEB_BUILD_MAINT_OPTIONS=hardening=+all future=+lfs
export DEB_CFLAGS_MAINT_APPEND = -fPIE
export DEB_LDFLAGS_MAINT_APPEND = -fPIE -pie

# Reimplement ./configure without relying on uname.
include /usr/share/dpkg/architecture.mk
ifeq (,$(filter linux kfreebsd,$(DEB_HOST_ARCH_OS)))
UPSTREAM_MAKEFILE=Makefile.bsd
else
UPSTREAM_MAKEFILE=Makefile.$(DEB_HOST_ARCH_OS)
endif

# Rules
%:
	dh $@ --buildsystem=makefile

override_dh_auto_configure:
	ln -sf $(UPSTREAM_MAKEFILE) Makefile

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr
